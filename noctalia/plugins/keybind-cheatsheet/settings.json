{
  "cheatsheetData": [
    {
      "title": "Keybinds",
      "binds": [
        {
          "keys": "Vol Up",
          "desc": "exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
          "_verb": "exec",
          "_param": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
          "_mods": "",
          "_mainKey": "XF86AUDIORAISEVOLUME"
        },
        {
          "keys": "Vol Down",
          "desc": "exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
          "_verb": "exec",
          "_param": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
          "_mods": "",
          "_mainKey": "XF86AUDIOLOWERVOLUME"
        },
        {
          "keys": "Mute",
          "desc": "exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
          "_verb": "exec",
          "_param": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
          "_mods": "",
          "_mainKey": "XF86AUDIOMUTE"
        },
        {
          "keys": "Mic Mute",
          "desc": "exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
          "_verb": "exec",
          "_param": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
          "_mods": "",
          "_mainKey": "XF86AUDIOMICMUTE"
        },
        {
          "keys": "Bright Up",
          "desc": "exec brightnessctl set 5%+",
          "_verb": "exec",
          "_param": "brightnessctl set 5%+",
          "_mods": "",
          "_mainKey": "XF86MONBRIGHTNESSUP"
        },
        {
          "keys": "Bright Down",
          "desc": "exec brightnessctl set 5%-",
          "_verb": "exec",
          "_param": "brightnessctl set 5%-",
          "_mods": "",
          "_mainKey": "XF86MONBRIGHTNESSDOWN"
        }
      ]
    }
  ],
  "detectedCompositor": "hyprland",
  "windowWidth": 1400,
  "windowHeight": 850,
  "autoHeight": true,
  "columnCount": 3,
  "modKeyVariable": "$mod",
  "hyprlandConfigPath": "~/.config/hypr/hyprland.conf",
  "hyprlandLuaConfigPath": "~/.config/hypr/hyprland.lua",
  "hyprlandParserMode": "auto",
  "niriConfigPath": "~/.config/niri/config.kdl",
  "mangoConfigPath": "~/.config/mango/config.conf",
  "mergeSequentialBinds": true,
  "showUndescribedBinds": true,
  "splitLargeWorkspaceCategory": true,
  "workspaceSplitThreshold": 12,
