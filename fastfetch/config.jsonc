//  |   __|  _  |   __|_   _|   __|   __|_   _|     |  |  |
//  |   __|     |__   | | | |   __|   __| | | |   --|     |
//  |__|  |__|__|_____| |_| |__|  |_____| |_| |_____|__|__|  OS
//
//  by Bina


{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "arch_small", // search for logos: fastfetch --list-logos or --print-logos
        "padding": {
	        "top": 1,
	        "left": 2
	},
    },
    "display": {
        "separator": "  "
    },
    "modules": [
	"break",
	"title",
        {
            "type": "os",
            "key": "os    ",
        },
        {   "type": "wm",
            "key" : "de    ",
        },
        {
            "type": "packages",
            "format": "{} (pacman)",
            "key": "pkgs  ", 
        },
        {   "type": "shell",
            "key": "shell ",
        },
        {
            "type": "kernel",
            "key": "kernel",
        },
        {
            "type": "uptime",
            "format": "{2}h {3}m",
            "key": "uptime",
        },
        {
            "type": "command",
            "key": "os age",
            "text": "install_date=$(awk 'NR==1{print $1}' /var/log/pacman.log | tr -d '[]'); birth_install=$(date -d \"$install_date\" +%s); current=$(date +%s); diff=$((current - birth_install)); days=$((diff / 86400)); hours=$(((diff % 86400) / 3600)); echo \"$days days $hours hrs\""
        },
        {
            "type": "memory",
            "key": "memory",
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        },
        "break"
    ]
}
